# Long random string you generate yourself, e.g. run:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ACCESS_KEY=replace-with-a-long-random-string

# Google Cloud service account (Drive API enabled), see README for steps.
# Paste the ENTIRE contents of the downloaded JSON key as a single line here.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# The Drive folder you shared with the service account's client_email.
# Grab this from the folder's URL: drive.google.com/drive/folders/<THIS_PART>
DRIVE_FOLDER_ID=replace-with-folder-id
