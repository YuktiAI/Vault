# Google OAuth client credentials.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://your-vercel-domain.vercel.app/api/google/callback

# Owner-only key used only to start the one-time OAuth setup flow.
GOOGLE_SETUP_KEY=replace-with-a-long-random-string

# The OAuth refresh token obtained during owner setup.
GOOGLE_REFRESH_TOKEN=your-google-refresh-token

# The Drive folder ID from its URL: drive.google.com/drive/folders/<THIS_PART>
DRIVE_FOLDER_ID=replace-with-folder-id
